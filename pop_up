struct FaceView: View {
    var smile: CGFloat

    var body: some View {
        ZStack {
            Circle()
                .stroke(.green2, lineWidth: 3)

            HStack(spacing: 10) {
                Circle().fill(.green2).frame(width: 5, height: 5)
                Circle().fill(.green2).frame(width: 5, height: 5)
            }
            .offset(y: -6)

            Path { path in
                let y: CGFloat = smile < 0 ? 31 : 27
                path.move(to: CGPoint(x: 14, y: y))
                path.addQuadCurve(
                    to: CGPoint(x: 30, y: y),
                    control: CGPoint(x: 22, y: y + smile * 8)
                )
            }
            .stroke(.green2, style: StrokeStyle(lineWidth: 3, lineCap: .round))
        }
        .frame(width: 44, height: 44)
    }
}

